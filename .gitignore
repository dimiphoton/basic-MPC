__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Coupe / pause de l'autopilot Cursor (local, ne pas committer)
.cursor/autopilot.off
.cursor/autopilot.pause

# Données brutes : pas de commit (taille/licence), on garde juste la structure
data/raw/*
!data/raw/.gitkeep

# Séries régénérables (le JSON qualité peut être versionné)
data/processed/*.csv

# Décommente si les modèles deviennent trop volumineux pour git classique
# models/*.pkl
# models/*.pt
